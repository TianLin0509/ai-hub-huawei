{
  "_骨架": "全景页·先总账后明细表",
  "_适用": "盘点类内容：项目清单、合作情况、能力全景。上面三条总账（带【】前缀和红字数字），下面明细表，右侧一栏亮点或风险",
  "_论证链": "总账（总量、布局、资源）→ 明细（逐项状态）→ 亮点与风险（因果，不只罗列）",
  "title": "定位语：存量XX项聚焦几条主线，新增XX项补短板",
  "titleStyle": "red",
  "col": [
    { "type": "text", "size": 92, "bullet": "•", "sz": 16, "spread": false, "items": ["**【总量】**存量 {r:XX} 个，新增 {r:XX} 个", "**【布局】**这里用一句话写主要分布在哪几个方向", "**【资源】**这里用一句话写资源情况"] },
    { "w": 1, "row": [
      { "type": "panel", "w": 2.6, "head": {"text": "明细", "style": "line", "align": "left"}, "body": { "type": "table", "sz": 12, "head": ["方向", "事项", "阶段", "本期目标", "状态"], "rows": [
        ["方向一", "事项甲", "阶段XX", "这里写目标", "{g:正常}"],
        ["方向一", "事项乙", "阶段XX", "这里写目标", "{g:正常}"],
        ["方向二", "事项丙", "阶段XX", "这里写目标", "{r:延期}"],
        ["方向二", "事项丁", "阶段XX", "这里写目标", "{g:正常}"],
        ["方向三", "事项戊", "待启动", "这里写目标", "{k:未启动}"],
        ["方向三", "事项己", "待启动", "这里写目标", "{k:未启动}"]
      ] } },
      { "type": "panel", "head": {"text": "亮点与风险", "style": "line", "align": "left"}, "body": { "col": [
        { "type": "card", "frame": "none", "num": 1, "title": "亮点", "titleSz": 14, "sz": 12, "items": ["这里写一条亮点，说明为什么算亮点"] },
        { "type": "card", "frame": "none", "num": 2, "title": "风险", "titleSz": 14, "sz": 12, "items": ["这里写一条风险和原因，{r:影响哪个节点}"] },
        { "type": "card", "frame": "none", "num": 3, "title": "建议", "titleSz": 14, "sz": 12, "items": ["这里写一条建议，说明要谁做什么"] }
      ], "gap": 4 } }
    ] }
  ]
}
